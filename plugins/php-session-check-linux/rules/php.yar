// PHP 세션 업로드 진행 설정 점검(0.6.0) — 패키지 밖 PHP 실행 파일(php · php-cgi · php-fpm · libphp*.so)의 판 문자열로 고친 판인지
// 가른다. `php-2026-11-check-linux` 의 `rules/php.yar` 와 같은 규칙이다 — 하나를 고치면 다른 하나도 고친다.
//
// PHP 는 응답 머리 `X-Powered-By: PHP/<판>` 을 컴파일 때 한 글자열로 박는다(main/SAPI.h 의 SAPI_PHP_VERSION_HEADER) —
// CLI · CGI · FPM · Apache 모듈 모두 SAPI 를 싣는다. 뒤 글자가 숫자가 아니어야 한다 — `8.3.3` 이 `8.3.36` 의 앞부분으로
// 맞지 않게. **정식 판만 '판을 읽었다' 로 센다**(0.1.1) — 뒤가 글자(시험판 `8.6.0RC7` · `8.6.0beta1`)나 `-dev`(개발 빌드)면
// 이 규칙이 맞지 않아 확인 필요다. 0.1.0 은 `8.6.0RC7` 을 정식 `8.6.0` 으로 읽어 0 을 냈다. `-` 뒤가 숫자인 꼴(배포판이
// 붙이는 꼬리)은 정식 판으로 센다.

rule php_version_string
{
    strings:
        $v = /X-Powered-By: PHP\/[0-9]{1,2}\.[0-9]{1,2}\.[0-9]{1,3}([^0-9A-Za-z\-]|-[0-9])/
    condition:
        $v
}

// 영향 범위(php.net · 2026-11-19 보안 릴리스): 고친 판은 8.5.13 · 8.4.28 · 8.3.37 · 8.2.36 이다. 각 갈래의 그 아래와,
// 지원이 끝나 고친 판이 없는 8.1 이하가 영향이다.
rule php_version_affected
{
    strings:
        $v = /X-Powered-By: PHP\/([1-7]\.[0-9]{1,2}\.[0-9]{1,3}|8\.[01]\.[0-9]{1,3}|8\.2\.([0-9]|[12][0-9]|3[0-5])|8\.3\.([0-9]|[12][0-9]|3[0-6])|8\.4\.([0-9]|1[0-9]|2[0-7])|8\.5\.([0-9]|1[0-2]))[^0-9]/
    condition:
        $v
}
